{
  "description": "技の枠 (lib/domain/battle/battle_engine.dart の equippedLearnsetEntries と functions/src/action_card_rules.ts の equippedMoveIDs) の共通のテストケース。expectedMoveIDs は枠の技の ID を枠の順に並べたもの",
  "cases": [
    {
      "name": "開放した技が 4 つ以下ならすべて",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "b", "unlockLevel": 1 },
        { "moveID": "c", "unlockLevel": 3 }
      ],
      "level": 2,
      "actionCardMoveIDs": [],
      "expectedMoveIDs": ["a", "b"]
    },
    {
      "name": "開放した技が 4 つを超えたら一覧の後ろの 4 つ",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "b", "unlockLevel": 1 },
        { "moveID": "c", "unlockLevel": 1 },
        { "moveID": "d", "unlockLevel": 1 },
        { "moveID": "e", "unlockLevel": 2 },
        { "moveID": "f", "unlockLevel": 3 }
      ],
      "level": 2,
      "actionCardMoveIDs": [],
      "expectedMoveIDs": ["b", "c", "d", "e"]
    },
    {
      "name": "開放レベルと同じレベルで開放する",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "b", "unlockLevel": 5 }
      ],
      "level": 5,
      "actionCardMoveIDs": [],
      "expectedMoveIDs": ["a", "b"]
    },
    {
      "name": "Action Card の技は learnset の後ろに覚えさせた順で続き、一番古い技が枠から外れる",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "b", "unlockLevel": 1 },
        { "moveID": "c", "unlockLevel": 1 },
        { "moveID": "d", "unlockLevel": 1 }
      ],
      "level": 1,
      "actionCardMoveIDs": ["x", "y"],
      "expectedMoveIDs": ["c", "d", "x", "y"]
    },
    {
      "name": "Action Card の技は開放レベルに関係なく Lv.1 から使える",
      "learnset": [{ "moveID": "a", "unlockLevel": 1 }],
      "level": 1,
      "actionCardMoveIDs": ["x"],
      "expectedMoveIDs": ["a", "x"]
    },
    {
      "name": "Action Card の技が 4 つを超えたら覚えさせた順で後ろの 4 つ",
      "learnset": [{ "moveID": "a", "unlockLevel": 1 }],
      "level": 1,
      "actionCardMoveIDs": ["v", "w", "x", "y", "z"],
      "expectedMoveIDs": ["w", "x", "y", "z"]
    },
    {
      "name": "learnset にある技を覚えさせたら learnset 側を外し、覚えさせた位置に置く",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "b", "unlockLevel": 1 },
        { "moveID": "c", "unlockLevel": 1 },
        { "moveID": "d", "unlockLevel": 1 }
      ],
      "level": 1,
      "actionCardMoveIDs": ["a"],
      "expectedMoveIDs": ["b", "c", "d", "a"]
    },
    {
      "name": "まだ開放していない learnset の技を覚えさせたら、開放した後も枠に 1 つだけ並ぶ",
      "learnset": [
        { "moveID": "a", "unlockLevel": 1 },
        { "moveID": "k", "unlockLevel": 100 }
      ],
      "level": 100,
      "actionCardMoveIDs": ["k"],
      "expectedMoveIDs": ["a", "k"]
    }
  ]
}
