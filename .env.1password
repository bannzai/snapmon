# 1Password の参照 (値ではない)。手元で使う時は op run --env-file .env.1password -- <コマンド> (例: make web)。
# 保管先の方針は ~/.claude/documents/rules/secret-storage-by-reader.md
# App Check の Web の debug token。make web (debug) が --dart-define で渡す。発行の手順は scripts/set-webtunnel-setup-env-secret.sh
FIREBASE_APPCHECK_DEBUG_TOKEN_WEB=op://snapmon/FIREBASE_APPCHECK_DEBUG_TOKEN_WEB/password

PLAY_SA_JSON_BASE64=op://bannzai/GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64/password
REVENUECAT_WEBHOOK_AUTHORIZATION=op://snapmon/REVENUECAT_WEBHOOK_AUTHORIZATION/password
IOS_PROVISIONING_PROFILE_BASE64=op://snapmon/IOS_PROVISIONING_PROFILE_BASE64/password
FIREBASE_APPCHECK_DEBUG_TOKEN_IOS=op://snapmon/FIREBASE_APPCHECK_DEBUG_TOKEN_IOS/password
FIREBASE_APPCHECK_DEBUG_TOKEN_ANDROID=op://snapmon/FIREBASE_APPCHECK_DEBUG_TOKEN_ANDROID/password
ANDROID_KEYSTORE_PASSWORD=op://snapmon/ANDROID_KEYSTORE_PASSWORD/password
ANDROID_KEYSTORE_JKS_BASE64=op://snapmon/ANDROID_KEYSTORE_JKS_BASE64/password
ANDROID_KEY_PROPERTIES_BASE64=op://snapmon/ANDROID_KEY_PROPERTIES_BASE64/password
