# 1Password の参照 (値ではない)。手元で使う時は op run --env-file .env.1password -- <コマンド> (例: make web)。
# 保管先の方針は ~/.claude/documents/rules/secret-storage-by-reader.md
# App Check の Web の debug token。make web (debug) が --dart-define で渡す。発行の手順は scripts/set-webtunnel-setup-env-secret.sh
FIREBASE_APPCHECK_DEBUG_TOKEN_WEB=op://snapmon/FIREBASE_APPCHECK_DEBUG_TOKEN_WEB/password
