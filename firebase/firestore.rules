rules_version = '2';

// 構造と書き込みの主体は .claude/rules/firestore.md と documents/adr/0001-tech-stack.md の DB の行。
// 構造を変える時は、このファイル・Rules のテスト (functions/test/emulator/firestore_rules.test.ts)・.claude/rules/firestore.md を同時に直す。
service cloud.firestore {
  match /databases/{database}/documents {
    // ログイン (匿名ログインを含む) したユーザーか。
    function isSignedIn() {
      return request.auth != null;
    }

    // ログインした本人か。
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ログインした本人で、アカウントが残っていて削除の途中でもないか (生成が users/{uid} を作り、deleteAccount が削除の始まりに
    // accountDeletionStartedAt を付けて最後に users/{uid} ごと消す)。クライアントが書く時に確かめる。
    // 削除の後も別の端末の ID トークンは期限まで通るため、消し終えた uid の配下に書かせない。
    // 手持ちに入れるモンスターは生成で生まれるため、手持ちを書くユーザーには users/{uid} がある。
    function isActiveOwner(uid) {
      return isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && !("accountDeletionStartedAt" in get(/databases/$(database)/documents/users/$(uid)).data);
    }

    // 本人の図鑑にあるモンスターか。
    function ownsMonster(uid, monsterID) {
      return monsterID is string
        && exists(/databases/$(database)/documents/users/$(uid)/monsters/$(monsterID));
    }

    // 手持ちの monsterIDs が「本人の図鑑にあるモンスターの ID を重複なく 3 件まで」か。
    // Rules にループが無いため、上限の 3 件を添字で確かめる。
    function isValidParty(uid, monsterIDs) {
      return monsterIDs is list
        && monsterIDs.size() <= 3
        && monsterIDs.toSet().size() == monsterIDs.size()
        && (monsterIDs.size() < 1 || ownsMonster(uid, monsterIDs[0]))
        && (monsterIDs.size() < 2 || ownsMonster(uid, monsterIDs[1]))
        && (monsterIDs.size() < 3 || ownsMonster(uid, monsterIDs[2]));
    }

    // master (属性・技・相性表・分類) の版。投入は Functions のデプロイ時のスクリプトだけが行う。
    match /master/{version} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 生成時にその場で作った属性・技の定義。他人のモンスターが参照する定義を端末で解決するため、ログインした全員が読める。
    match /definitions/{definitionID} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 技ごとの Action Card の商品の表。購入の画面で技の値段を出すため、ログインした全員が読める。書くのは updateActionCardProducts (Functions) だけ。
    match /actionCardProducts/{actionCardProductsID} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 機能を出すかの切り替え (Action Card を出すか等)。書くのは functions/scripts/set-feature-flag.mjs (Admin SDK) だけ。
    match /config/{configID} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 技の 1 日の使用回数。技に割り振る商品の計算 (Functions) だけが使う。
    match /moveUsageDailyCounts/{day} {
      allow read, write: if false;
    }

    // 通報・ブロックは Functions 経由で書き、クライアントから直接読み書きしない。
    match /reports/{reportID} {
      allow read, write: if false;
    }
    match /blocks/{blockID} {
      allow read, write: if false;
    }
    // 通報したユーザー数のカウンタ。通報した人を他人に知られないよう、クライアントから読ませない。
    match /reportedMonsters/{monsterID} {
      allow read, write: if false;
    }

    // 人との対戦の待ちの札。組み合わせは Functions (joinPvpMatch) だけが行い、誰が相手を探しているかをクライアントから読ませない。
    match /pvpMatchTickets/{uid} {
      allow read, write: if false;
    }

    // 人との対戦 1 戦。対戦に出ている 2 人だけが読み (相手の手持ちの他人に見せてよい項目の写し・表示名・アイコン・今のターンの番号・終わり方)、
    // 書くのは Functions だけ (行動と結果を改ざんさせないため)。
    // 無い対戦の 1 件の読み取りは、ログインしていれば「無い」と返す (resource == null)。対戦の途中で相手がアカウントを消して
    // 対戦が消えた時に、残った側の購読が拒否ではなく「無い」を受け取り、対戦を終えられるようにするため (lib/firebase/pvp.dart の
    // watchPvpBattleWithFirebase)。ID は Functions が作る推測できない値で、無いことから分かる情報は無い。
    match /pvpBattles/{battleID} {
      // 一覧は読ませない (端末は組み合わされた対戦の ID を joinPvpMatch から受け取り、1 件だけを購読する)。
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid == resource.data.host.uid || request.auth.uid == resource.data.guest.uid);
      allow list, write: if false;

      // 2 人が各ターンに出した行動 (ID は {uid}_{turnNumber})。利用者は、自分が同じターンの行動を出した後にだけ、そのターンの行動を
      // 1 件ずつ読める (相手の行動を見てから選べないようにするため)。相手がまだ出していない時は、読み取りは通って「無い」と返る。
      // 行動を書けるのは Functions が対戦に出ていると確かめた利用者だけのため、自分の行動があることが、対戦に出ていることも示す。
      // 一覧は読ませない (自分の行動を出していないターンの相手の行動を含むため)。
      match /turns/{turnID} {
        // turnID の最後の `_` の後ろ (ターンの番号) を返す。uid に `_` が含まれていても番号は最後の区切りの後ろにある
        function turnNumberOf() {
          return turnID.split('_')[turnID.split('_').size() - 1];
        }
        allow get: if isSignedIn()
          && exists(/databases/$(database)/documents/pvpBattles/$(battleID)/turns/$(request.auth.uid + '_' + turnNumberOf()));
        allow list, write: if false;
      }
    }

    match /users/{uid} {
      // ユーザーのドキュメントには Functions が生成中ロック等を書く。
      allow read: if isOwner(uid);
      allow write: if false;

      match /monsters/{monsterID} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /generations/{requestID} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /battles/{battleID} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 生成チケットの購入の記録。RevenueCat の webhook (Functions) だけが書く (残高を改ざんさせないため)。
      match /ticketPurchases/{eventID} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Action Card の購入の記録 (買い切った技は購入の moveID)。書くのは webhook と assignActionCardMove (Functions) だけ (持っている技を改ざんさせないため)。
      match /actionCardPurchases/{eventID} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 手持ち。クライアントが書ける 2 つのうちの 1 つ。
      match /party/current {
        allow read, delete: if isOwner(uid);
        allow create, update: if isActiveOwner(uid)
          && request.resource.data.keys().hasOnly(['monsterIDs', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && isValidParty(uid, request.resource.data.monsterIDs);
      }

      // 端末の設定。クライアントが書ける 2 つのうちの 1 つ。
      match /settings/current {
        allow read, delete: if isOwner(uid);
        allow create, update: if isActiveOwner(uid);
      }
    }
  }
}
