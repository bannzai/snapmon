<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ログインと同時に計測を始め、DEBUG ビルドでログインを飛ばした時は計測しないため、Analytics と Crashlytics の自動収集を既定で無効にする。
	     ログインの後に lib/firebase/session.dart が有効にする -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<!-- App Check の iOS プラグインは Firebase の初期化だけで DeviceCheck の provider を置くため、トークンの自動取得を既定で止める。
	     ログインの前に lib/firebase/session.dart の activateAppCheck が有効にする -->
	<key>FirebaseAppCheckTokenAutoRefreshEnabled</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SnapMonster</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SnapMonster</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- 「データを引き継ぐ」の Google のサインイン (firebase_auth の linkWithProvider) が、ブラウザの画面からアプリに戻る時の URL scheme。
	     値は Firebase の iOS アプリの ID (firebase.json の flutter.platforms.ios.default.appId。GoogleService-Info.plist の
	     GOOGLE_APP_ID と同じ値) の「:」を「-」に替えて「app-」を前に付けたもの (firebase-ios-sdk の OAuthProvider.swift の
	     callbackScheme)。この scheme が登録されていないと、Google を選んだ時に SDK が fatalError でアプリを落とす
	     (同ファイルの "Please register custom URL scheme")。Firebase の iOS アプリを作り直して ID が変わった時は、この値も直す
	     (test/firebase/account_link_url_scheme_test.dart が firebase.json と食い違うと落ちる) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-1032186168570-ios-8942cc45bb72e5b027f543</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- 輸出コンプライアンスの申告。無いとビルドを上げるたびに App Store Connect で答える必要がある。
	     false にしたのは owner の判断 (2026-11-17)。アプリのコードは暗号を直接呼ばない (lib に暗号の呼び出しが無い)。
	     ただし iOS のビルドは Firestore の gRPC 経由で BoringSSL (google/grpc-binary の openssl_grpc) を含む。Apple の表は
	     「OS が提供しない業界標準の暗号を使う」場合、フランスで配信する時にフランスの暗号申告書を求めている
	     (https://developer.apple.com/help/app-store-connect/reference/export-compliance-documentation-for-encryption/ 、2026-11-17 に確認)。
	     owner はこれを知った上で false のまま進めると決めた。独自の暗号を使う依存を足した時と、Apple から指摘を受けた時は見直す -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>身の回りの物を撮ってモンスターを生み出すためにカメラを使います</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>共有するカード画像を写真に保存するために使います</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>アルバムの写真からモンスターを生み出すために写真を読み込みます</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
