{
  "definitions": {
    "version": 6,
    "elementTypes": [
      {
        "id": "fire",
        "displayName": "炎",
        "description": "火や熱を出す・熱い物を扱う・火を使う物 (ろうそく・ライター・コンロ・鍋・やかん・アイロン・ドライヤー・暖房・温かい料理や飲み物)、または赤やオレンジが主な色の物"
      },
      {
        "id": "water",
        "displayName": "水",
        "description": "水や液体を入れる・運ぶ・浴びる物、雨や水辺の物 (水筒・コップの中の飲み物・じょうろ・傘やレインコート・洗面や風呂の道具・貝殻)、または青が主な色の物"
      },
      {
        "id": "grass",
        "displayName": "草",
        "description": "生きている草や葉・観葉植物・野菜・苗・芝 (花は「花」、木材は「木」)、または緑が主な色の物"
      },
      {
        "id": "thunder",
        "displayName": "雷",
        "description": "電気や電池で動く・電気を通す物 (スマートフォン・パソコン・キーボード・家電・ケーブル・電池・コンセント)、または黄色が主な色の物"
      },
      {
        "id": "steel",
        "displayName": "鋼",
        "description": "金属 (鉄・ステンレス・アルミ・銅・ブリキ・ホーロー) が主な素材で動く仕組みの無い物 (刃物・缶・鍵・釘・金属の食器や金具)、または銀色の物"
      },
      {
        "id": "light",
        "displayName": "光",
        "description": "光を出す・光を通す・光を映す物 (ランプ・電球・懐中電灯・鏡・レンズ・ガラスの瓶や窓・画面)、または白や透明が主な色の物"
      },
      {
        "id": "machine",
        "displayName": "機械",
        "description": "動く仕組み (歯車・モーター・車輪・ばね・ねじ) を持つ物 (車・自転車・時計・カメラ・ロボットのおもちゃ・ミシン・ドライバーなどの工具)"
      },
      {
        "id": "sweets",
        "displayName": "菓子",
        "description": "お菓子・デザート・果物・甘い飲み物 (ケーキ・チョコレート・クッキー・あめ・アイス・ジュース)、またはピンクや淡い色が主な色の物"
      },
      {
        "id": "cloth",
        "displayName": "布",
        "description": "布・糸・毛糸・フェルト・革・綿が主な素材の物 (服・タオル・毛布・かばん・靴下・ぬいぐるみの生地)"
      },
      {
        "id": "paper",
        "displayName": "紙",
        "description": "紙・段ボールが主な素材の物 (本・ノート・手紙・カード・箱・折り紙・紙袋)"
      }
    ],
