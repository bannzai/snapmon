      },
      {
        "id": "water",
        "displayName": "水",
        "description": "水や液体を入れる・運ぶ・浴びる物、または水の中や水辺のもの (水筒・やかん・コップの中の水・じょうろ・貝殻・雨具)"
      },
      {
        "id": "heat",
        "displayName": "熱",
        "description": "熱を出す・熱い物を扱う・火に関わる物 (ろうそく・ライター・コンロ・鍋・やかん・アイロン・温かい飲み物・暖房)"
      },
      {
        "id": "paper",
        "displayName": "紙",
        "description": "主な素材が紙・段ボール・本・カードの物"
      },
      {
        "id": "cloth",
        "displayName": "布",
        "description": "主な素材が布・糸・毛糸・革・フェルト・綿の物 (服・ぬいぐるみ・かばん・タオル)"
      },
      {
        "id": "plastic",
        "displayName": "樹脂",
        "description": "主な素材がプラスチック・ゴム・ビニール・樹脂の物"
      },
      {
        "id": "electric",
        "displayName": "電気",
        "description": "電気や電池で動く・電気を通す・光を出す物 (家電・電子機器・電球・電池・ケーブル)"
      },
      {
