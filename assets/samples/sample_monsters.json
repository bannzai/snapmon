    "moves": [
      {
        "id": "fire_1",
        "displayName": "ほかほかタッチ",
        "elementTypeId": "fire",
        "power": 40,
        "powerPoints": 30,
        "category": "attack",
        "effectId": "fire_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "rationale": "温かい手や湯たんぽでほかほか触れる技で、熱を伝えるため炎の技にした"
      },
      {
        "id": "fire_1b",
        "displayName": "ゆげのもや",
        "elementTypeId": "fire",
        "power": 35,
        "powerPoints": 35,
        "category": "attack",
        "effectId": "fire_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "specialEffect": {
          "power": "if(movesFirst, 130, 100)",
          "summary": "先に動くと強い",
          "rule": "先に行動すると威力が上がる",
          "rationale": "湯気のもやは相手が動く前に視界を覆うため、先に動いた時に強くなる効果にした"
        },
        "rationale": "湯気のもやで包む技で、熱い湯から出るため炎の技にした"
      },
      {
        "id": "fire_2",
        "displayName": "ねつふうしゃ",
        "elementTypeId": "fire",
        "power": 70,
        "powerPoints": 15,
        "category": "attack",
        "effectId": "fire_particle",
        "learnableLevelMinimum": 15,
        "learnableLevelMaximum": 200,
        "rationale": "暖房の熱風を吹きつける技のため炎の技にした"
      },
      {
        "id": "water_1",
        "displayName": "しずくだま",
        "elementTypeId": "water",
        "power": 40,
        "powerPoints": 30,
        "category": "attack",
        "effectId": "water_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "rationale": "水のしずくを玉にしてぶつける技のため水の技にした"
      },
      {
        "id": "water_1b",
        "displayName": "じょうろシャワー",
        "elementTypeId": "water",
        "power": 35,
        "powerPoints": 35,
        "category": "attack",
        "effectId": "water_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "specialEffect": {
          "power": "if(sharesElementType, 150, 100)",
          "summary": "同じ属性の相手に強い",
          "rule": "相手と同じ属性を持つと威力が上がる",
          "rationale": "水を浴びせると同じ仲間 (同じ素材) ほどよく染み込むため、自分と同じ属性を持つ相手に強くなる効果にした。技の名前と効果の結びつきが弱く、次に効果を見直す時に入れ替えを検討する"
        },
        "rationale": "じょうろで水を浴びせる技で、水を運ぶ道具のため水の技にした"
      },
      {
        "id": "water_2",
        "displayName": "ホースほうすい",
        "elementTypeId": "water",
        "power": 70,
        "powerPoints": 15,
        "category": "attack",
        "effectId": "water_particle",
        "learnableLevelMinimum": 15,
        "learnableLevelMaximum": 200,
        "rationale": "ホースで水を勢いよく放水する技のため水の技にした (版 4 の「みずでっぽう」は他社の技名と同じ名前のため改めた)"
      },
      {
        "id": "grass_1",
        "displayName": "はっぱシュート",
        "elementTypeId": "grass",
        "power": 40,
        "powerPoints": 30,
        "category": "attack",
        "effectId": "grass_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "rationale": "生きた葉っぱを勢いよく飛ばす技のため草の技にした (版 4 の「はっぱカッター」は他社の技名と同じ名前のため改めた)"
      },
      {
        "id": "grass_1b",
        "displayName": "わたげとばし",
        "elementTypeId": "grass",
        "power": 35,
        "powerPoints": 35,
        "category": "attack",
        "effectId": "grass_particle",
        "learnableLevelMinimum": 1,
        "learnableLevelMaximum": 30,
        "specialEffect": {
          "power": "if(not sharesElementType, 120, 100)",
          "summary": "違う属性の相手に強い",
          "rule": "相手と同じ属性を持たないと威力が上がる",
          "rationale": "綿毛は風に乗って遠くの別の土地へ飛んでいくため、自分と違う属性の相手に強くなる効果にした"
        },
        "rationale": "たんぽぽの綿毛を飛ばす技で、生きた草花の種のため草の技にした"
      },
      {
        "id": "grass_2",
        "displayName": "つるしめつけ",
        "elementTypeId": "grass",
        "power": 70,
        "powerPoints": 15,
        "category": "attack",
        "effectId": "grass_particle",
